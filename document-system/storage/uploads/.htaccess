# ห้ามเปิดไฟล์อัปโหลดตรงจากเว็บ ต้องดาวน์โหลดผ่าน download.php หลังเข้าสู่ระบบ
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
